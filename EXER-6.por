programa
{
	
	funcao inicio()
	{
		real num1, num2

        escreva("Digite o primeiro numero: ")
        leia(num1)

        escreva("Digite o segundo numero: ")
        leia(num2)

        se (num1 > num2)
        {
            escreva("\nO maior numero é ", num1)
        }
        senao
        {
            escreva("\nO maior numero é ", num2)
        }
	}
}

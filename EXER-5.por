programa
{
	
	funcao inicio()
	{
		 real temperatura

        escreva("Digite a temperatura: ")
        leia(temperatura)

        se (temperatura >= 0)
        {
            escreva("\nA temperatura é positiva.")
        }
        senao
        {
            escreva("\nA temperatura é negativa.")
        }
	}
}
